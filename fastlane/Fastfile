default_platform(:ios)

SCHEME              = "SleepDaddy"
BUNDLE_ID           = "fm.rodeo.SleepDaddy"
PROFILE_NAME        = "match AppStore #{BUNDLE_ID}"

platform :ios do
  desc "Archive a signed build and upload it to TestFlight"
  lane :beta do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true,
    )

    match(
      type: "appstore",
      readonly: true,
      api_key: api_key,
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "SleepDaddy.xcodeproj",
      team_id: ENV.fetch("DEVELOPMENT_TEAM"),
      bundle_identifier: BUNDLE_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: PROFILE_NAME,
    )

    build_app(
      scheme: SCHEME,
      export_method: "app-store",
      export_options: {
        provisioningProfiles: { BUNDLE_ID => PROFILE_NAME },
      },
    )

    upload_to_testflight(
      api_key: api_key,
      skip_submission: true,
      skip_waiting_for_build_processing: true,
    )
  end
end
